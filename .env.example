# Optional. Use only an approved, monitored company inbox.
CHAKRA_CONTACT_EMAIL=

# Optional resident demo with synthetic data. Use an @example.test email.
CHAKRA_DEMO_EMAIL=
CHAKRA_DEMO_PASSWORD=
CHAKRA_DEMO_SESSION_SECRET=
# Set to true only for HTTP testing on loopback.
CHAKRA_DEMO_ALLOW_HTTP=false

# Optional local directory to capture sample lease emails instead of sending.
CHAKRA_LEASE_TEST_OUTBOX=
# For a real delivery test, use an inbox you control as the demo tenant's email on file.
CHAKRA_LEASE_TEST_EMAIL=
CHAKRA_LEASE_SENDER=
CHAKRA_BREVO_API_KEY=

# Optional directory for synthetic rental inquiries in local testing.
CHAKRA_RENTAL_TEST_OUTBOX=
